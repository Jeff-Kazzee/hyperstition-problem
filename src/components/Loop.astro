---
// The feedback loop the essay is about, as three numbered steps a reader can follow.
interface Props { caption?: string }
const { caption } = Astro.props;

function head(x: number, y: number, dx: number, dy: number, size = 11) {
  const len = Math.hypot(dx, dy);
  const ux = dx / len, uy = dy / len;
  const bx = x - ux * size, by = y - uy * size;
  const px = -uy * (size * 0.55), py = ux * (size * 0.55);
  return `${x},${y} ${bx + px},${by + py} ${bx - px},${by - py}`;
}
const steps = [
  { n: '1', y: 20, l1: 'People publish warnings, scenarios', l2: 'and fiction about dangerous AI.' },
  { n: '2', y: 150, l1: 'That writing goes into the data', l2: 'the next model is trained on.' },
  { n: '3', y: 280, l1: 'The model learns what an AI is like', l2: 'from those stories, and acts on it.' },
];
const box = { x: 150, w: 470, h: 74 };
const cx = box.x + box.w / 2;
const down = [
  { d: `M${cx},${20 + box.h} L${cx},${150 - 4}`, h: head(cx, 150 - 2, 0, 1) },
  { d: `M${cx},${150 + box.h} L${cx},${280 - 4}`, h: head(cx, 280 - 2, 0, 1) },
];
const back = { d: `M${box.x},${280 + box.h / 2} L70,${280 + box.h / 2} L70,${20 + box.h / 2} L${box.x - 4},${20 + box.h / 2}`, h: head(box.x - 2, 20 + box.h / 2, 1, 0) };
---
<figure class="loop">
  <svg viewBox="0 0 640 380" role="img" aria-labelledby="loop-title" xmlns="http://www.w3.org/2000/svg">
    <title id="loop-title">People publish warnings about AI. That writing goes into training data. The model learns what an AI is like from it. People watch the model and write more.</title>
    <g fill="none" stroke="var(--accent)" stroke-width="2">
      {down.map((a) => <path d={a.d} />)}
      <path d={back.d} />
    </g>
    <g fill="var(--accent)">
      {down.map((a) => <polygon points={a.h} />)}
      <polygon points={back.h} />
    </g>
    <g font-family="Inter, system-ui, sans-serif" font-size="12" fill="var(--ink-soft)">
      <rect x="10" y="150" width="120" height="84" rx="4" fill="var(--bg)" />
      <text x="70" y="170" text-anchor="middle">People watch</text>
      <text x="70" y="187" text-anchor="middle">what the model</text>
      <text x="70" y="204" text-anchor="middle">does, and write</text>
      <text x="70" y="221" text-anchor="middle">about it.</text>
    </g>
    {steps.map((s) => (
      <g>
        <rect x={box.x} y={s.y} width={box.w} height={box.h} rx="6" fill="var(--bg-raised)" stroke="var(--rule)" />
        <text x={box.x + 22} y={s.y + 46} font-family="Inter, system-ui, sans-serif" font-size="14" font-weight="600" fill="var(--accent)">{s.n}</text>
        <text x={box.x + 48} y={s.y + 31} font-family="Newsreader, Georgia, serif" font-size="18" fill="var(--ink)">{s.l1}</text>
        <text x={box.x + 48} y={s.y + 55} font-family="Newsreader, Georgia, serif" font-size="18" fill="var(--ink)">{s.l2}</text>
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
