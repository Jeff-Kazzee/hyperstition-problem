---
// The feedback loop the essay is about, drawn once so both themes can use currentColor.
interface Props { caption?: string }
const { caption } = Astro.props;

// Arrowheads are plain polygons so every renderer (and every RSS reader) shows them.
function head(x: number, y: number, dx: number, dy: number, size = 11) {
  const len = Math.hypot(dx, dy);
  const ux = dx / len, uy = dy / len;
  const bx = x - ux * size, by = y - uy * size;
  const px = -uy * (size * 0.55), py = ux * (size * 0.55);
  return `${x},${y} ${bx + px},${by + py} ${bx - px},${by - py}`;
}
const arrows = [
  { d: 'M170,100 C250,48 390,48 470,100', h: head(470, 100, 80, 50) },
  { d: 'M535,150 C548,200 515,238 480,242', h: head(480, 242, -40, 4) },
  { d: 'M160,242 C125,238 92,200 105,150', h: head(105, 150, 12, -50) },
];
---
<figure class="loop">
  <svg viewBox="0 0 640 300" role="img" aria-labelledby="loop-title" xmlns="http://www.w3.org/2000/svg">
    <title id="loop-title">The corpus trains the model, the model shapes what people write about AI, and that writing joins the corpus.</title>
    <g fill="none" stroke="var(--accent)" stroke-width="2">
      {arrows.map((a) => <path d={a.d} />)}
    </g>
    <g fill="var(--accent)">
      {arrows.map((a) => <polygon points={a.h} />)}
    </g>
    <g font-family="Inter, system-ui, sans-serif" font-size="13" fill="var(--ink-soft)" text-anchor="middle">
      <text x="320" y="44">training</text>
      <text x="560" y="292">what an AI is like</text>
      <text x="100" y="292">warnings, scenarios, fiction</text>
    </g>
    <g font-family="Newsreader, Georgia, serif" font-size="20" fill="var(--ink)" text-anchor="middle">
      <rect x="40" y="96" width="130" height="56" rx="6" fill="var(--bg-raised)" stroke="var(--rule)" />
      <text x="105" y="131">the corpus</text>
      <rect x="470" y="96" width="130" height="56" rx="6" fill="var(--bg-raised)" stroke="var(--rule)" />
      <text x="535" y="131">the model</text>
      <rect x="180" y="214" width="280" height="56" rx="6" fill="var(--bg-raised)" stroke="var(--rule)" />
      <text x="320" y="249">people writing about AI</text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
